datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id               Int      @id
  name             String
  slug             String   @unique
  sku              String?
  type             String   @default("simple")
  price            Float
  regularPrice     Float
  salePrice        Float?
  onSale           Boolean  @default(false)
  shortDescription String
  description      String
  specs            String?  // JSON string
  categories       String   // JSON string array
  images           String   // JSON string array
  attributes       String?  // JSON string
  variations       String?  // JSON string
  rating           Float    @default(5.0)
  reviewCount      Int      @default(0)
  inStock          Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model Category {
  id          Int     @id
  name        String
  slug        String  @unique
  count       Int     @default(0)
  description String?
}

model Post {
  id            Int      @id
  title         String
  slug          String   @unique
  excerpt       String?
  content       String
  date          DateTime
  author        String   @default("Dr. Usman")
  category      String   @default("Research")
  featuredImage String?
}

model Page {
  id      Int    @id
  title   String
  slug    String @unique
  content String
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress String   // JSON string
  items           String   // JSON string
  subtotal        Float
  discount        Float    @default(0)
  shippingFee     Float    @default(0)
  total           Float
  paymentMethod   String
  status          String   @default("pending")
  createdAt       DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("customer")
  createdAt    DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  productId Int
  author    String
  rating    Int
  content   String
  date      DateTime @default(now())
}
